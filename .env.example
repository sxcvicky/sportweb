# 本地开发默认值：复制成 .env 即可跑通 mock 全链路。
# 生产部署时改：NODE_ENV=production、APP_BASE_URL、APP_SECRET、ADMIN_PASSWORD，
# 再把 LLM / 企微 / 支付切到真实模式并填对应密钥。

# 部署域名（Caddy 使用；本地 localhost）
DOMAIN=localhost

# 应用
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_BASE_URL=http://127.0.0.1:8787
APP_SECRET=dev-only-change-me
ADMIN_PASSWORD=admin123

# 会话 / 报告
SESSION_TTL_DAYS=365
ADMIN_SESSION_HOURS=12
REPORT_TOKEN_TTL_DAYS=90
REPORT_RETENTION_DAYS=365
FREE_REPORT_DAILY_LIMIT=3
REPORT_DAILY_GLOBAL_LIMIT=200
CREATE_DIAGNOSIS_HOURLY_LIMIT=20

# 数据库
DATABASE_PATH=./data/app.db
WEB_DIR=web

# LLM（OpenAI 兼容接口；DeepSeek 示例）
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.4

# 企微
# mock：本地演示，点按钮模拟已加企微
# wecom：真实企微活码 + 回调
WECOM_MODE=mock
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CONTACT_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_STAFF_USER_ID=
WECOM_QR_URL=/assets/img/wecom-qr.png
WECOM_WECHAT_ID=yueji-service

# 支付
# mock：本地演示，点按钮模拟付款成功
# wechat：微信支付 v3 Native 扫码
PAY_MODE=mock
PAY_AMOUNT_CENTS=990
PAY_APP_ID=
PAY_MCH_ID=
PAY_API_V3_KEY=
PAY_SERIAL_NO=
PAY_PRIVATE_KEY_PATH=
PAY_PLATFORM_PUBLIC_KEY_PATH=
PAY_NOTIFY_URL=
